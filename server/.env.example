# ============================================
# ChatSphere Server Environment Variables
# Copy this file to .env and fill in values
# ============================================

# Server
NODE_ENV=development
PORT=5001

# MongoDB
MONGODB_URI=mongodb://localhost:27017/chatsphere
# AI Assistant
GEMINI_API_KEY=your_gemini_api_key_here

# JWT
JWT_ACCESS_SECRET=asdfghjbbjejknjcbcbjhcb
JWT_REFRESH_SECRET=asdfghjbbjejknjcbcbjhcb
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=1d

# OTP
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6

# CORS
CORS_ORIGIN=http://localhost:4200

# File Upload (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
UPLOAD_DIR=uploads
MAX_FILE_SIZE=52428800

# Firebase Cloud Messaging (optional)
# FCM_SERVER_KEY=your_fcm_server_key

# Encryption
# E2EE keys are generated client-side; backend only stores public keys

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
LOG_DIR=logs
